{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch Lab",
  "version": "0.3.0",
  "identifier": "org.dispatchlab.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "resources": {
      "../../build/desktop/payload/": "payload/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "dispatch-run"
        ],
        "name": "Dispatch Lab recording",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
