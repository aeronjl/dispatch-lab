# Keep authored research, protocols, summaries and test fixtures in Git.
# Large numerical evidence and downloaded source material remain local;
# see research/README.md and research/local-artifacts.json for this boundary.
/research/**/unpacked/
/research/**/reproduction.zip
/research/**/source-capsule.json
/research/field-realism-review/experiments/**/cases/**/*.json.gz
/research/field-realism-review/experiments/**/cases/**/audit.json
